# ETAPA C — NUMAI după decizia separată de mutare a runnerului oficial (vezi docs/PROXMOX.md).
# NU se folosește în modul observer și nu rulează în paralel cu GitHub Actions.
FROM python:3.13-slim
RUN useradd --system --uid 10001 --no-create-home bnd && mkdir /data && chown bnd /data
WORKDIR /app
COPY src ./src
ENV BND_TRADING_MODE=PAPER BND_ALLOW_LIVE_AI=false PYTHONUNBUFFERED=1
USER bnd
VOLUME /data
# Doar PAPER: safety.py refuză orice altceva.
CMD ["python", "-m", "src.bnd.paper_runner", "--state", "/data/paper.sqlite", "--data-dir", "/data/candles", "--audit-log", "/data/audit.jsonl", "--report", "/data/REPORT.md", "--json", "/data/last_run.json"]

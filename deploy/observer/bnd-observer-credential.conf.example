# Opțional, privilegii minime: tokenul rămâne root:root 0600 în /etc și nu trebuie citibil de utilizatorul serviciului.
# systemd (rulând ca root) îl copiază într-un tmpfs privat al serviciului, vizibil ca $CREDENTIALS_DIRECTORY/github-token;
# gitauth.sh îl folosește automat când BND_TOKEN_FILE nu e setat.
# Instalare: sudo systemctl edit bnd-observer  (lipește conținutul de mai jos), apoi
#            sudo chown root:root /etc/bnd-observer/github-read-token && sudo chmod 0600 /etc/bnd-observer/github-read-token
# și comentează BND_TOKEN_FILE din /etc/bnd-observer/env. Cere systemd >= 250 (Debian 12/13).
[Service]
LoadCredential=github-token:/etc/bnd-observer/github-read-token

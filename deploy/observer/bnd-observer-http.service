[Unit]
Description=BND observer: status.json pentru Home Assistant (doar LAN/VPN, doar citire)
After=network.target

[Service]
User=bnd-observer
EnvironmentFile=/etc/bnd-observer/env
# Servește DOAR folderul public/ (status.json), pe loopback; expune-l în LAN/VPN printr-un proxy sau un firewall.
ExecStartPre=/usr/bin/bash /opt/bnd-observer/deploy/observer/http-bind-check.sh
ExecStart=/usr/bin/python3 -m http.server 8765 --bind ${BND_HTTP_BIND} --directory /var/lib/bnd-observer/public
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/bnd-observer
Restart=on-failure

[Install]
WantedBy=multi-user.target

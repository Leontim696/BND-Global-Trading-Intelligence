# /etc/bnd-observer/env — fără chei de broker sau AI. Poți pune doar calea unui token DOAR contents:read.
BND_OBSERVER_ONLY=true
BND_TRADING_MODE=PAPER
BND_ALLOW_LIVE_AI=false
BND_DATA_DIR=/var/lib/bnd-observer
# BND_TOKEN_FILE=/etc/bnd-observer/github-read-token   (chmod 600, owner root; token fine-grained, doar Contents: Read)

# /etc/bnd-observer/env — fără chei de broker sau AI. Poți pune doar calea unui token DOAR contents:read.
BND_OBSERVER_ONLY=true
BND_TRADING_MODE=PAPER
BND_ALLOW_LIVE_AI=false
BND_DATA_DIR=/var/lib/bnd-observer
# Repo privat: tokenul se salvează cu `sudo bash deploy/observer/set-token.sh` (root:bnd-observer, 0640), apoi decomentează:
# BND_TOKEN_FILE=/etc/bnd-observer/github-read-token

# Serviciul HTTP (status.json pentru Home Assistant) nu pornește singur: `install.sh --with-http`.
# Implicit loopback. Orice altă adresă cere BND_HTTP_ALLOW_NON_LOOPBACK=yes (vezi docs/PROXMOX.md).
BND_HTTP_BIND=127.0.0.1
